# Copy this file to .env and fill in the providers you plan to use.
# python-dotenv loads .env from the project root with override=True.

# OpenAI backend
# Required for: --backends openai:...
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic backend
# Required for: --backends anthropic:...
# Also required by the current integration tests.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Ollama backend
# Optional. Only needed if your Ollama server is not at the default local URL.
# Required for: --backends ollama:... when using a custom host.
OLLAMA_HOST=http://localhost:11434
